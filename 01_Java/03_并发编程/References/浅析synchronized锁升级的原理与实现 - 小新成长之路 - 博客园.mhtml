.skin-simplememory #sideBarMain { width: 100%; float: none; padding: 10px; =
margin-right: 0px; }

.skin-custom #mainContent { float: none; margin-left: 0px; }

.blogpost-body, .blogpost-body p { font-size: 14px; }

#main { width: auto; flex-wrap: wrap; }

