 rgba(255, 255, 255, 0.1); }

.menu-item { width: 56px; display: flex; align-items: center; font-size: 14=
px; flex-direction: column; color: rgb(255, 255, 255); padding: 16px 0px; l=
etter-spacing: 0px; }

.menu-item.max-item { width: fit-content; }

.menu-item.close-ad-item { width: fit-content; min-width: 74px; margin: 0px=
 8px; }

.menu-item.feedback-ad-item { width: fit-content; min-width: 41px; margin-r=
ight: 8px; }

.menu-item-icon { width: 20px; height: 20px; background-color: currentcolor=
; display: block; mask-repeat: no-repeat; mask-size: 100%; margin-bottom: 4=
px; }

.menu-item-label { text-align: center; line-height: 20px; }

.menu-item-underline { border-bottom: 1px solid white; }

.menu-item:last-child { border-bottom-width: medium; border-bottom-style: n=
one; border-bottom-color: currentcolor; }

.menu-item:hover { background-color: rgba(0, 0, 0, 0.1); }

